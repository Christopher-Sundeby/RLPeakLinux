{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RLPeak",
  "version": "1.1.0",
  "identifier": "com.rlpeak.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RLPeak",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
